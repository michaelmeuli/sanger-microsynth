# Gmail: use an app password (Google account > Security > 2-step verification > App passwords).
# Copy to ~/.config/sanger-microsynth/mail.env (chmod 600). Never commit it.
IMAP_HOST=imap.gmail.com
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
# Matched anywhere in the message (forwarded mails lose the original From)
SENDER_FILTER=microsynth
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_TO=
