# Copy to ~/.config/sanger-microsynth/mail.env (chmod 600). Never commit it.
IMAP_HOST=imap.uzh.ch
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
# Substring matched against the From header of result mails
SENDER_FILTER=microsynth
SMTP_HOST=smtp.uzh.ch
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_TO=
